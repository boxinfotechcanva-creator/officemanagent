<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ data extraction rules. Excludes the Room database and
    shared preferences from both cloud backup and device-to-device
    transfer to prevent exfiltration of business data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="box_infotech.db" />
        <exclude domain="database" path="box_infotech.db-shm" />
        <exclude domain="database" path="box_infotech.db-wal" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="box_infotech.db" />
        <exclude domain="database" path="box_infotech.db-shm" />
        <exclude domain="database" path="box_infotech.db-wal" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
